rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /members/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }
    match /runs/{id} {
      allow read, create: if signedIn();
      allow update: if admin() || (
        signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'distance'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.distance is number
        && request.resource.data.distance >= 0.1
        && request.resource.data.distance <= 500
      );
      allow delete: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }
    match /payments/{id} {
      allow read: if signedIn();
      allow create, update: if admin()
        && request.resource.data.keys().hasAll(['memberId', 'month', 'paid', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['memberId', 'month', 'paid', 'updatedBy', 'updatedAt'])
        && request.resource.data.memberId is string
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && id == request.resource.data.month + '_' + request.resource.data.memberId
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId))
        && request.resource.data.paid is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /admins/{id} { allow read: if signedIn() && request.auth.uid == id; }
    match /settings/{id} {
      allow read: if signedIn() && id == "access";
      allow write: if admin();
    }
  }
}
